# Azure OpenAI (ARCHITECTURE §4.1, §10)
AZURE_OPENAI_ENDPOINT=https://<ton-resource>.openai.azure.com
# Laisse vide pour utiliser Entra ID (DefaultAzureCredential) — recommandé
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Déploiement par défaut pour tous les rôles…
AZURE_OPENAI_DEPLOYMENT=gpt-5
# …surcharges par rôle (optionnel)
# CT_DEPLOYMENT_ARCHITECT=
# CT_DEPLOYMENT_WRITER=
# CT_DEPLOYMENT_SOURCER=
# CT_DEPLOYMENT_JUDGE=
# CT_DEPLOYMENT_CRITIC=

# Grounding with Bing (Foundry Agent Service)
AZURE_AI_PROJECT_ENDPOINT=https://<ton-projet>.services.ai.azure.com/api/projects/<projet>
AZURE_BING_CONNECTION_ID=
# CT_DEPLOYMENT_SEARCH_AGENT=

# Réglages du pipeline (optionnel)
# CT_ARTICLE_LANGUAGE=fr
# CT_SEARCH_CANDIDATES=4
# CT_CRITIC_MAX_ITERATIONS=3
